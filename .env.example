# EduTrack AI — Configurações do Banco de Dados PostgreSQL

# Opção 1: URL de Conexão Completa (Recomendado)
DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/edutrack

# Opção 2: Variáveis Individuais de Conexão
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=suasenha
# PGDATABASE=edutrack
